                {"key": "nationalId", "value": "", "disabled": true},
                {"key": "firstName", "value": "", "disabled": true},
                {"key": "lastName", "value": "Lopez"},
                {"key": "page", "value": "1"},
                {"key": "limit", "value": "10"}
