          }
        }
      ]
    },
    {
      "name": "Appointments",
      "item": [
        {
          "name": "Create appointment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.id) pm.collectionVariables.set('appointmentId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": {{doctorId}},\n  \"medicalCenterId\": 1,\n  \"officeId\": 1,\n  \"startAt\": \"2026-08-10T10:00:00.000Z\",\n  \"endAt\": \"2026-08-10T10:30:00.000Z\",\n  \"reasonForVisit\": \"Consulta general\",\n  \"patient\": {\n    \"nationalId\": \"0912345678\",\n    \"firstName\": \"Maria\",\n    \"lastName\": \"Lopez\",\n    \"email\": \"maria.lopez@example.com\",\n    \"phone\": \"0999999999\",\n    \"dateOfBirth\": \"1990-05-20\",\n    \"gender\": \"FEMENINO\",\n    \"medicalHistoryNotes\": \"Sin antecedentes relevantes\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/appointments",
              "host": ["{{baseUrl}}"],
              "path": ["appointments"]
            }
          }
        },
        {
          "name": "Reschedule appointment",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startAt\": \"2026-08-11T11:00:00.000Z\",\n  \"endAt\": \"2026-08-11T11:30:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/appointments/{{appointmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["appointments", "{{appointmentId}}"]
            }
          }
        },
        {
          "name": "List patient appointments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/appointments/patient/0912345678",
              "host": ["{{baseUrl}}"],
              "path": ["appointments", "patient", "0912345678"]
            }
          }
        }
      ]
