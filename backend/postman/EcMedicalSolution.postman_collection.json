    {
      "name": "Patients",
      "description": "Requiere Bearer token (cualquier usuario autenticado, no solo SA). Ejecuta Auth > Login o Auth > Login as doctor primero para obtener el token.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{token}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Create patient (with triage vitals)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.patient && body.patient.id) pm.collectionVariables.set('patientId', body.patient.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nationalId\": \"0912345678\",\n  \"firstName\": \"Maria\",\n  \"lastName\": \"Lopez\",\n  \"email\": \"maria.lopez@example.com\",\n  \"phone\": \"0999999999\",\n  \"dateOfBirth\": \"1990-05-20\",\n  \"gender\": \"FEMENINO\",\n  \"medicalHistoryNotes\": \"Sin antecedentes relevantes\",\n  \"vitals\": {\n    \"bloodPressure\": \"120/80\",\n    \"heartRateBpm\": 78,\n    \"weightKg\": 65.5\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/patients",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "patients"]
            }
          }
        },
