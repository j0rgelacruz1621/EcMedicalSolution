            "body": {
              "mode": "raw",
              "raw": "{\n  \"medicalCenterId\": 1,\n  \"officeNumber\": \"101\",\n  \"locationDetails\": \"Primer piso, ala norte\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/medical-centers/offices",
              "host": ["{{baseUrl}}"],
