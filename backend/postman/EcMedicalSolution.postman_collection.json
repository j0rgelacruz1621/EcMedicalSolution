    {
      "name": "Tasks",
      "description": "Requiere Bearer token. Ejecuta primero Users > 'Create doctor login (SA)' y luego Auth > 'Login as doctor' para obtener un token con el claim `doctorId` verificado. Un medico solo puede ver/modificar tareas de su propio doctorId; las cuentas con rol SA pueden operar sobre cualquier doctor.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{token}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Create task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.id) pm.collectionVariables.set('taskId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Revisar examenes de laboratorio\",\n  \"description\": \"Paciente Maria Lopez\",\n  \"priority\": \"URGENT\",\n  \"due_date\": \"2026-08-20T10:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/doctors/{{doctorId}}/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "doctors", "{{doctorId}}", "tasks"]
            }
          }
        },
        {
          "name": "List doctor tasks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/doctors/{{doctorId}}/tasks?status=PENDING&sortBy=priority&order=desc&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "doctors", "{{doctorId}}", "tasks"],
              "query": [
                {"key": "status", "value": "PENDING"},
                {"key": "sortBy", "value": "priority"},
                {"key": "order", "value": "desc"},
                {"key": "page", "value": "1"},
                {"key": "limit", "value": "10"}
              ]
            }
          }
        },
        {
          "name": "Doctor tasks summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/doctors/{{doctorId}}/tasks/summary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "doctors", "{{doctorId}}", "tasks", "summary"]
            }
          }
        },
        {
          "name": "Update task status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"COMPLETED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks/{{taskId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks", "{{taskId}}", "status"]
            }
          }
        },
        {
          "name": "Delete task",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks", "{{taskId}}"]
            }
          }
