generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Doctor {
  id            BigInt           @id @default(autoincrement())
  licenseNumber String           @unique @map("license_number") @db.VarChar(50)
  nationalId    String           @unique @map("national_id") @db.VarChar(30)
  firstName     String           @map("first_name") @db.VarChar(100)
  lastName      String           @map("last_name") @db.VarChar(100)
  email         String           @unique @db.VarChar(150)
  phone         String?          @db.VarChar(20)
  specialty     String?          @db.VarChar(100)
  gender        gender_enum?
  officeId      BigInt?          @map("office_id")
  isActive      Boolean?         @default(true) @map("is_active")
  createdAt     DateTime?        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime?        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  description   String?
  rif           String?          @map("rif") @db.VarChar(20)
  cmNumber      String?          @map("cm_number") @db.VarChar(50)
  photoUrl      String?          @map("photo_url") @db.Text
  schedules     DoctorSchedule[]
  appointments  Appointment[]
  recipes       Recipe[]
  medicalReports MedicalReport[]
  laboratoryOrders LaboratoryOrder[]
  assignedPatients Patient[]
  office        Office?          @relation(fields: [officeId], references: [id], onUpdate: NoAction, map: "fk_doctors_office")
  reports       reports[]
  tasks         tasks[]

  @@map("doctors")
}

model MedicalCenter {
  id        BigInt    @id @default(autoincrement())
  name      String    @db.VarChar(150)
  address   String?
  phone     String?   @db.VarChar(20)
  isActive  Boolean?  @default(true) @map("is_active")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  offices      Office[]
  appointments Appointment[]
  recipes      Recipe[]
  medicalReports MedicalReport[]
  laboratoryOrders LaboratoryOrder[]

  @@map("medical_centers")
}

model Office {
  id              BigInt         @id @default(autoincrement())
  medicalCenterId BigInt?        @map("medical_center_id")
  officeNumber    String         @map("office_number") @db.VarChar(50)
  locationDetails String?        @map("location_details") @db.VarChar(255)
  isActive        Boolean?       @default(true) @map("is_active")
  createdAt       DateTime?      @default(now()) @map("created_at") @db.Timestamptz(6)
  doctors         Doctor[]
  appointments    Appointment[]
  medicalCenter   MedicalCenter? @relation(fields: [medicalCenterId], references: [id], onUpdate: NoAction, map: "fk_offices_medical_center")

  @@map("offices")
}

model Patient {
  id                  BigInt           @id @default(autoincrement())
  nationalId          String           @unique @map("national_id") @db.VarChar(30)
  firstName           String           @map("first_name") @db.VarChar(100)
  lastName            String           @map("last_name") @db.VarChar(100)
  email               String           @db.VarChar(150)
  phone               String           @db.VarChar(20)
  age                 Int?
  origin              String?          @db.VarChar(100)
  address             String?          @db.VarChar(255)
  assignedDoctorId    BigInt?          @map("assigned_doctor_id")
  assignedDoctor      Doctor?          @relation(fields: [assignedDoctorId], references: [id], onUpdate: Cascade, onDelete: SetNull, map: "fk_patients_assigned_doctor")
  gender              gender_enum
  medicalHistoryNotes String?          @map("medical_history_notes")
  isActive            Boolean?         @default(true) @map("is_active")
  createdAt           DateTime?        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime?        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  appointments        Appointment[]
  patient_vitals      patient_vitals[]
  reports             reports[]
  recipes             Recipe[]
  medicalReports      MedicalReport[]
  laboratoryOrders    LaboratoryOrder[]

  @@index([nationalId], map: "idx_patients_national_id")
  @@map("patients")
}

model Appointment {
  id              BigInt                   @id @default(autoincrement())
  appointmentCode String                   @unique @map("appointment_code") @db.VarChar(20)
  patientId       BigInt?                  @map("patient_id")
  doctorId        BigInt                   @map("doctor_id")
  medicalCenterId BigInt?                  @map("medical_center_id")
  officeId        BigInt?                  @map("office_id")
  appointmentDate DateTime                 @map("appointment_date") @db.Date
  startTime       DateTime                 @map("start_time") @db.Time(6)
  endTime         DateTime                 @map("end_time") @db.Time(6)
  reasonForVisit  String?                  @map("reason_for_visit")
  type            String?                  @default("De primera") @db.VarChar
  status          appointment_status_enum? @default(SCHEDULED)
  createdAt       DateTime?                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime?                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  doctor          Doctor                   @relation(fields: [doctorId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "appointments_doctor_id_fkey")
  medicalCenter   MedicalCenter?           @relation(fields: [medicalCenterId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "appointments_medical_center_id_fkey")
  office          Office?                  @relation(fields: [officeId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "appointments_office_id_fkey")
  patient         Patient?                 @relation(fields: [patientId], references: [id], onUpdate: NoAction, map: "fk_appointments_patient")
  guestNationalId String?                  @map("guest_national_id") @db.VarChar(30)
  guestFirstName  String?                  @map("guest_first_name") @db.VarChar(100)
  guestLastName   String?                  @map("guest_last_name") @db.VarChar(100)
  guestEmail      String?                  @map("guest_email") @db.VarChar(150)
  guestPhone      String?                  @map("guest_phone") @db.VarChar(20)
  guestAge        Int?                     @map("guest_age")
  guestGender     gender_enum?             @map("guest_gender")
  patient_vitals  patient_vitals[]
  reports         reports[]
  recipes         Recipe[]
  medicalReports  MedicalReport[]
  laboratoryOrders LaboratoryOrder[]

  @@index([appointmentDate, doctorId], map: "idx_appointments_date_doctor")
  @@map("appointments")
}

model DoctorSchedule {
  id                  BigInt           @id @default(autoincrement())
  doctorId            BigInt           @map("doctor_id")
  dayOfWeek           day_of_week_enum @map("day_of_week")
  startTime           DateTime         @map("start_time") @db.Time(6)
  endTime             DateTime         @map("end_time") @db.Time(6)
  slotDurationMinutes Int?             @default(30) @map("slot_duration_minutes")
  createdAt           DateTime?        @default(now()) @map("created_at") @db.Timestamptz(6)
  doctor              Doctor           @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_doctor_schedules_doctor")

  @@map("doctor_schedules")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model patient_vitals {
  id                       BigInt       @id @default(autoincrement())
  patient_id               BigInt
  appointment_id           BigInt?
  blood_pressure_systolic  Int?
  blood_pressure_diastolic Int?
  heart_rate_bpm           Int?
  weight_kg                Decimal?     @db.Decimal(5, 2)
  measured_at              DateTime?    @default(now()) @db.Timestamptz(6)
  created_at               DateTime?    @default(now()) @db.Timestamptz(6)
  appointments             Appointment? @relation(fields: [appointment_id], references: [id], onUpdate: NoAction, map: "fk_vitals_appointment")
  patients                 Patient      @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([patient_id], map: "idx_patient_vitals_patient")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model reports {
  id             BigInt              @id @default(autoincrement())
  patient_id     BigInt
  doctor_id      BigInt
  appointment_id BigInt?
  title          String              @db.VarChar(200)
  content        String?
  file_url       String?             @db.VarChar(500)
  status         report_status_enum? @default(PENDING_REVIEW)
  created_at     DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?           @default(now()) @db.Timestamptz(6)
  appointments   Appointment?        @relation(fields: [appointment_id], references: [id], onUpdate: NoAction)
  doctors        Doctor              @relation(fields: [doctor_id], references: [id], onUpdate: NoAction)
  patients       Patient             @relation(fields: [patient_id], references: [id], onUpdate: NoAction)

  @@index([doctor_id, status], map: "idx_reports_doctor_status")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model tasks {
  id          BigInt              @id @default(autoincrement())
  doctor_id   BigInt
  title       String              @db.VarChar(200)
  description String?
  priority    task_priority_enum? @default(MEDIUM)
  status      task_status_enum?   @default(PENDING)
  due_date    DateTime?           @db.Timestamptz(6)
  created_at  DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?           @default(now()) @db.Timestamptz(6)
  doctors     Doctor              @relation(fields: [doctor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([doctor_id, status], map: "idx_tasks_doctor_status")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id          BigInt   @id @default(autoincrement())
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  user_name   String   @db.VarChar
  password    String   @db.VarChar
  rol         String?  @db.VarChar
  application String?  @db.VarChar
}

enum appointment_status_enum {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum appointment_type_enum {
  FIRST_TIME
  CONTROL
  EMERGENCY
  ROUTINE
}

enum day_of_week_enum {
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
  Sunday
}

enum gender_enum {
  Male
  Female
  Other
}

enum report_status_enum {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum task_priority_enum {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum task_status_enum {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum recipe_status_enum {
  ACTIVE
  EDITED
  CANCELLED
}

enum recipe_version_type_enum {
  ORIGINAL
  SUPERSEDED
}

model Recipe {
  id                     BigInt                     @id @default(autoincrement())
  patientId              BigInt                     @map("patient_id")
  doctorId               BigInt                     @map("doctor_id")
  medicalCenterId        BigInt?                    @map("medical_center_id")
  appointmentId          BigInt?                    @map("appointment_id")
  issueDate              DateTime                   @default(now()) @map("issue_date") @db.Date
  headerImageUrl         String?                    @map("header_image_url") @db.Text
  additionalInstructions String?                    @map("additional_instructions") @db.VarChar(500)
  status                 recipe_status_enum         @default(ACTIVE)
  versionType            recipe_version_type_enum   @default(ORIGINAL) @map("version_type")
  supersedesRecipeId     BigInt?                    @map("supersedes_recipe_id")
  createdAt              DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  patient                Patient                    @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_recipes_patient")
  doctor                 Doctor                     @relation(fields: [doctorId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_recipes_doctor")
  medicalCenter          MedicalCenter?             @relation(fields: [medicalCenterId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_recipes_medical_center")
  appointment            Appointment?               @relation(fields: [appointmentId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_recipes_appointment")
  supersedes             Recipe?                    @relation("RecipeVersions", fields: [supersedesRecipeId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_recipes_supersedes")
  supersededBy           Recipe[]                   @relation("RecipeVersions")
  medications            RecipeMedication[]

  @@index([patientId, issueDate], map: "recipes_patient_id_issue_date_idx")
  @@index([doctorId, issueDate], map: "recipes_doctor_id_issue_date_idx")
  @@index([status], map: "recipes_status_idx")
  @@map("recipes")
}

model RecipeMedication {
  id           BigInt   @id @default(autoincrement())
  recipeId     BigInt   @map("recipe_id")
  drugName     String   @map("drug_name") @db.VarChar(150)
  presentation String?  @db.VarChar(100)
  dose         String?  @db.VarChar(100)
  frequency    String?  @db.VarChar(100)
  duration     String?  @db.VarChar(100)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  recipe       Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_recipe_medications_recipe")

  @@index([recipeId, sortOrder], map: "recipe_medications_recipe_id_sort_order_idx")
  @@map("recipe_medications")
}

enum medical_report_type_enum {
  REPOSO_MEDICO
  CONSTANCIA_ASISTENCIA
  INFORME_MEDICO
}

enum medical_report_status_enum {
  ACTIVE
  EDITED
  SIGNED
  CANCELLED
}

model MedicalReport {
  id              BigInt                       @id @default(autoincrement())
  patientId       BigInt                       @map("patient_id")
  doctorId        BigInt                       @map("doctor_id")
  medicalCenterId BigInt?                      @map("medical_center_id")
  appointmentId   BigInt?                      @map("appointment_id")
  title           String                       @db.VarChar(200)
  type            medical_report_type_enum     @default(INFORME_MEDICO)
  description     String?                      @db.VarChar(500)
  content         String
  issueDate       DateTime                     @default(now()) @map("issue_date") @db.Date
  restStartDate   DateTime?                    @map("rest_start_date") @db.Date
  restEndDate     DateTime?                    @map("rest_end_date") @db.Date
  restDays        Int?                         @map("rest_days")
  diagnosisCode   String?                      @map("diagnosis_code") @db.VarChar(20)
  diagnosis       String?                      @db.VarChar(500)
  headerImageUrl  String?                      @map("header_image_url") @db.Text
  status          medical_report_status_enum   @default(ACTIVE)
  createdAt       DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  patient         Patient                      @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_medical_reports_patient")
  doctor          Doctor                       @relation(fields: [doctorId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_medical_reports_doctor")
  medicalCenter   MedicalCenter?               @relation(fields: [medicalCenterId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_medical_reports_medical_center")
  appointment     Appointment?                 @relation(fields: [appointmentId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_medical_reports_appointment")

  @@index([patientId, issueDate], map: "medical_reports_patient_id_issue_date_idx")
  @@index([doctorId, issueDate], map: "medical_reports_doctor_id_issue_date_idx")
  @@index([type], map: "medical_reports_type_idx")
  @@index([status], map: "medical_reports_status_idx")
  @@map("medical_reports")
}

model LaboratoryCategory {
  id          BigInt              @id @default(autoincrement())
  name        String              @unique @db.VarChar(100)
  description String?             @db.VarChar(500)
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tests       LaboratoryTest[]

  @@map("laboratory_categories")
}

model LaboratoryTest {
  id          BigInt             @id @default(autoincrement())
  categoryId  BigInt             @map("category_id")
  internalCode String?           @map("internal_code") @db.VarChar(50)
  name        String             @db.VarChar(150)
  loincCode   String?            @map("loinc_code") @db.VarChar(20)
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  category    LaboratoryCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_laboratory_tests_category")
  orderItems  LaboratoryOrderTest[]

  @@index([categoryId], map: "laboratory_tests_category_id_idx")
  @@map("laboratory_tests")
}

model LaboratoryOrder {
  id              BigInt   @id @default(autoincrement())
  patientId       BigInt   @map("patient_id")
  doctorId        BigInt   @map("doctor_id")
  medicalCenterId BigInt?  @map("medical_center_id")
  appointmentId   BigInt?  @map("appointment_id")
  issueDate       DateTime @default(now()) @map("issue_date") @db.Date
  diagnosis       String?  @db.VarChar(500)
  additionalNotes String?  @map("additional_notes")
  headerImageUrl  String?  @map("header_image_url") @db.Text
  status          String   @default("ACTIVE") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  patient         Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_laboratory_orders_patient")
  doctor          Doctor             @relation(fields: [doctorId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_laboratory_orders_doctor")
  medicalCenter   MedicalCenter?     @relation(fields: [medicalCenterId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_laboratory_orders_medical_center")
  appointment     Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_laboratory_orders_appointment")
  catalogTests    LaboratoryOrderTest[]
  customTests     LaboratoryOrderCustomTest[]

  @@index([patientId, issueDate], map: "laboratory_orders_patient_id_issue_date_idx")
  @@index([doctorId, issueDate], map: "laboratory_orders_doctor_id_issue_date_idx")
  @@index([status], map: "laboratory_orders_status_idx")
  @@map("laboratory_orders")
}

model LaboratoryOrderTest {
  id        BigInt   @id @default(autoincrement())
  orderId   BigInt   @map("order_id")
  testId    BigInt   @map("test_id")
  categoryId BigInt  @map("category_id")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order     LaboratoryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_lot_order")
  test      LaboratoryTest  @relation(fields: [testId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_lot_test")

  @@index([orderId, sortOrder], map: "laboratory_order_tests_order_id_idx")
  @@map("laboratory_order_tests")
}

model LaboratoryOrderCustomTest {
  id           BigInt   @id @default(autoincrement())
  orderId      BigInt   @map("order_id")
  categoryName String?  @map("category_name") @db.VarChar(100)
  testName     String   @map("test_name") @db.VarChar(200)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order        LaboratoryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_loct_order")

  @@index([orderId, sortOrder], map: "laboratory_order_custom_tests_order_id_idx")
  @@map("laboratory_order_custom_tests")
}
